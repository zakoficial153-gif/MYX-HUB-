local function addCorner(parent, radius)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius)
	corner.Parent = parent
	return corner
end

local function borderSequence()
	return ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(120, 90, 0)),
		ColorSequenceKeypoint.new(0.35, Color3.fromRGB(220, 160, 10)),
		ColorSequenceKeypoint.new(0.6, Color3.fromRGB(255, 215, 60)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(150, 110, 0))
	})
end

local function addGradientStroke(parent, thickness)
	local stroke = Instance.new("UIStroke")
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Thickness = thickness
	stroke.Color = Color3.new(1, 1, 1)
	stroke.Parent = parent

	local gradient = Instance.new("UIGradient")
	gradient.Color = borderSequence()
	gradient.Parent = stroke

	return gradient
end

