--========================================================--
-- EXECUTAR LENNON HUB
--========================================================--

button.Activated:Connect(function()

	status.Text = "LOADING • LENNON HUB"

	task.spawn(function()
		local success, err = pcall(function()
			loadstring(game:HttpGet(
				"https://api.jnkie.com/api/v1/luascripts/public/1554195c72a24159655fa8fc96a6863bd12fdccde497186b4e4e80356c37bd58/download"
			))()
		end)

		if success then
			status.Text = "LENNON HUB • LOADED"
		else
			status.Text = "LENNON HUB • ERROR"
			warn("[MYX HUB] Lennon Hub error:", err)
		end

		task.delay(2, function()
			if status and status.Parent then
				status.Text = "BY ZAK"
			end
		end)
	end)
end)

--========================================================--
-- MINIMIZAR
--========================================================--

local expandedSize = UDim2.fromOffset(280, 190)
local collapsedSize = UDim2.fromOffset(280, 50)

local collapsed = false

minimize.Activated:Connect(function()
	collapsed = not collapsed

	minimize.Text = collapsed and "+" or "-"

	if collapsed then
		content.Visible = false
	else
		content.Visible = true
	end

	TweenService:Create(
		menu,
		TweenInfo.new(
			0.3,
			Enum.EasingStyle.Quart,
			Enum.EasingDirection.InOut
		),
		{
			Size = collapsed and collapsedSize or expandedSize
		}
	):Play()
end)

--========================================================--
-- ANIMAÇÃO
--========================================================--

RunService.RenderStepped:Connect(function(dt)

	local speed = dt * 60

	outerGradient.Rotation =
		(outerGradient.Rotation + 0.9 * speed) % 360

	accentGradient.Rotation =
		(accentGradient.Rotation + 1.4 * speed) % 360

	titleGradient.Rotation =
		(titleGradient.Rotation + 1.2 * speed) % 360

	minimizeGradient.Rotation =
		(minimizeGradient.Rotation + 1.6 * speed) % 360

	if buttonGradient then
		buttonGradient.Rotation =
			(buttonGradient.Rotation + 1.8 * speed) % 360
	end
end)

